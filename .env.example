# Primary Mavis provider. Gemini 2.5 Flash is the default production model.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
MODEL_PROVIDER=gemini

# Automatic fallback for Gemini rate-limit or transient-provider failures.
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated frontend origins permitted to call the Render API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.example

# Public visitors receive this many completed Mavis responses per persistent browser identity.
GUEST_MESSAGE_LIMIT=10
PUBLIC_REQUESTS_PER_MINUTE=12

# Use the internal URL of a Render Postgres database to preserve quotas across Free-service sleeps and deploys.
# Leave blank only for local development, where Mavis uses a SQLite fallback.
DATABASE_URL=postgresql://USER:PASSWORD@INTERNAL_HOST:5432/DATABASE

# Owner mode is server-verified and expires after this many seconds. Keep PC control off in cloud deployments.
OWNER_PASSKEY=replace_with_a_long_private_passkey
OWNER_SESSION_TTL_SECONDS=43200
PC_CONTROL_ENABLED=false

# Render generates this automatically through render.yaml. Use a long random value only for local testing.
SESSION_SECRET=replace_with_a_long_random_secret
