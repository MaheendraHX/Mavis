# Required for Mavis chat on Render.
GROQ_API_KEY=replace_with_your_groq_api_key

# Comma-separated frontend origins permitted to call the Render API.
# Add your production frontend URL before deploying.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.example

# Keep PC control disabled in cloud deployments.
PC_CONTROL_ENABLED=false

# Optional owner-only access. Leave unset if the owner mode is not in use.
OWNER_PASSKEY=replace_with_a_private_passkey

# Render generates this automatically from render.yaml. Set one locally only when testing owner sessions.
SESSION_SECRET=replace_with_a_long_random_secret
